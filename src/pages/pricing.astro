---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { PLANS, installUrl, launched } from "../data/site";

const rows: [string, string, string, string][] = [
  ["Eligible orders included", "100 per cycle", "500", "2,000"],
  ["Extra orders", "—", "$0.02 each, up to 2,000", "$0.01 each, up to 10,000"],
  ["Maximum monthly bill", "Free", "$49.99", "$129.99"],
  ["Profit dashboard, costs, orders, products, customers", "✓", "✓", "✓"],
  ["Reporting history", "90 days", "365 days", "Full history"],
  ["Saved views per report", "1", "10", "10"],
  ["Custom metrics", "3", "25", "25"],
  ["Custom report builder", "1 saved template", "10 saved reports", "50 with revision history"],
  ["Exports", "CSV", "CSV, Excel, PDF", "CSV, Excel, PDF"],
  ["Profit planning", "—", "✓", "✓"],
  // Launch features (shown only once live; see LAUNCH in data/site.ts).
  ...(launched(["reportDelivery"]) ? ([
    ["Profit digest email", "Weekly or monthly", "Daily, weekly or monthly", "Daily, weekly or monthly"],
    ["Scheduled reports", "1 schedule", "10 schedules", "25 schedules"],
    ["Secure report links", "—", "10 active", "50 active"],
  ] as [string, string, string, string][]) : []),
  ...(launched(["googleSheets"]) ? ([
    ["Google Sheets sync", "—", "—", "25 destinations"],
  ] as [string, string, string, string][]) : []),
  ...(launched(["alerts"]) ? ([
    ["Alerts", "Essential data-safety alerts", "Profit, fee, promotion and stock alerts with your thresholds", "All alerts, longer baselines and advanced scopes"],
  ] as [string, string, string, string][]) : []),
  ...((launched(["metaAds"]) || launched(["googleAds"])) ? ([
    ["Ad platforms (Meta Ads, Google Ads)", "One platform", "Both", "Both"],
    ["Attribution history", "90 days", "365 days", "Full history"],
  ] as [string, string, string, string][]) : []),
  ...(launched(["surveys"]) ? ([
    ["Post-purchase surveys", "1 survey", "5 surveys with exports", "25 surveys with exports"],
  ] as [string, string, string, string][]) : []),
];
const schema = [{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Optifin",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Shopify",
  offers: PLANS.map((p) => ({ "@type": "Offer", name: p.name, price: p.price.toFixed(2), priceCurrency: "USD" })),
}];
---
<BaseLayout
  title="Pricing: Free Starter Plan | Optifin"
  description="Optifin pricing: Starter is free for 100 orders, Growth from $19.99/month, Scale from $49.99/month. Billed through Shopify, cancel any time."
  breadcrumbs={[{ name: "Pricing", href: "/pricing/" }]}
  schema={schema}
  headerTone="dark"
>
  <PageHero eyebrow="Pricing" title="Start free. Pay as your store grows." lead="Billed through Shopify on your normal invoice. Change plans or cancel any time." center />

  <section class="plans-wrap">
    <div class="container plans" data-reveal-group>
      {PLANS.map((p) => (
        <article class:list={["plan card", { featured: p.featured }]}>
          {p.featured && <span class="badge badge--soon flag">Most popular</span>}
          <h2 class="h3">{p.name}</h2>
          <p class="price"><span class="tabular">{p.priceLabel}</span>{p.price > 0 && <small>/month base</small>}</p>
          <p class="note">{p.note}</p>
          <a class:list={["btn", p.featured ? "btn--primary" : "btn--ghost"]} href={installUrl(`pricing-${p.key}`)}>Install on Shopify</a>
          <ul>{p.highlights.map((h) => <li><Icon name="check" size={16} /> {h}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="h2 table-title" data-reveal>Compare plans</h2>
      <div class="table-wrap" data-reveal>
        <table>
          <thead><tr><th scope="col">Feature</th>{PLANS.map((p) => <th scope="col">{p.name}</th>)}</tr></thead>
          <tbody>{rows.map(([label, ...vals]) => <tr><th scope="row">{label}</th>{vals.map((v) => <td>{v}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="small muted fine">
        Prices in USD. An eligible order is a Shopify order Optifin processes in the billing cycle. Usage charges never exceed the plan's maximum.
        Features marked coming soon on this site are not included in any plan yet.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .plans-wrap { background: linear-gradient(var(--navy-900) 0 40%, var(--surface) 40%); padding-bottom: 20px; }
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .plan { padding: 34px; display: grid; gap: 16px; align-content: start; position: relative; box-shadow: var(--shadow); }
  .plan.featured { border: 2px solid var(--brand-500); }
  .flag { position: absolute; top: -13px; left: 30px; background: #eaf2ff; }
  .price { font-family: var(--font-display); font-size: 52px; font-weight: 700; letter-spacing: -0.03em; line-height: 1; }
  .price small { font-size: 15px; color: var(--ink-muted); font-weight: 500; margin-left: 6px; letter-spacing: 0; }
  .note { color: var(--ink-soft); font-size: 14.5px; min-height: 3.2em; }
  .plan ul { list-style: none; padding: 16px 0 0; margin: 0; border-top: 1px solid var(--line); display: grid; gap: 10px; font-size: 15px; }
  .plan li { display: flex; gap: 8px; }
  .plan :global(svg) { color: var(--profit); flex: none; margin-top: 4px; }
  .table-title { margin-bottom: 28px; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); }
  table { width: 100%; border-collapse: collapse; min-width: 640px; }
  th, td { padding: 16px 20px; text-align: left; border-bottom: 1px solid var(--line); font-size: 15.5px; }
  thead th { background: var(--surface-2); font-family: var(--font-display); font-size: 16px; }
  tbody th { font-weight: 500; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  .fine { margin-top: 18px; max-width: 80ch; }
  @media (max-width: 900px) { .plans { grid-template-columns: 1fr; } }
</style>
