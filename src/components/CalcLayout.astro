---
// Shared shell for the free calculators: inputs on one side, live result on
// the other, explanation below.
interface Props { title: string }
const { title } = Astro.props;
---
<section class="section calc-section">
  <div class="container calc">
    <form class="calc-form card" aria-label={title} onsubmit="return false">
      <slot name="inputs" />
    </form>
    <div class="calc-result" aria-live="polite">
      <slot name="result" />
    </div>
  </div>
</section>
<section class="section section--soft">
  <div class="container prose">
    <slot />
  </div>
</section>

<style>
  .calc-section { padding-top: 0; margin-top: -60px; position: relative; }
  .calc { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: stretch; }
  .calc-form { padding: 32px; display: grid; gap: 18px; box-shadow: var(--shadow); }
  .calc-form :global(label) { display: grid; gap: 8px; font-weight: 600; font-size: 15px; }
  .calc-form :global(.hint) { font-weight: 400; color: var(--ink-muted); font-size: 13.5px; }
  .calc-form :global(.field) { position: relative; display: flex; align-items: center; }
  .calc-form :global(.field span) { position: absolute; left: 14px; color: var(--ink-muted); font-weight: 500; }
  .calc-form :global(.field span.suffix) { left: auto; right: 14px; }
  .calc-form :global(input) {
    width: 100%; height: 50px; border: 1.5px solid var(--line-strong); border-radius: 12px; padding: 0 14px 0 30px;
    font: inherit; font-size: 17px; font-variant-numeric: tabular-nums; background: #fff; color: var(--ink);
  }
  .calc-form :global(select) {
    width: 100%; height: 50px; border: 1.5px solid var(--line-strong); border-radius: 12px; padding: 0 14px;
    font: inherit; font-size: 16px; background: #fff; color: var(--ink);
  }
  .calc-form :global(select:focus) { outline: none; border-color: var(--brand-500); box-shadow: 0 0 0 4px rgb(59 130 246 / 0.15); }
  .calc-form :global(input.pct) { padding: 0 96px 0 14px; }
  .calc-form :global(input:focus) { outline: none; border-color: var(--brand-500); box-shadow: 0 0 0 4px rgb(59 130 246 / 0.15); }
  .calc-result { border-radius: var(--radius); background: var(--navy-900); color: #fff; padding: 34px; display: grid; align-content: center; gap: 22px; box-shadow: var(--shadow-lg); position: relative; overflow: hidden; }
  .calc-result::before { content: ""; position: absolute; width: 520px; height: 520px; right: -200px; top: -240px; border-radius: 50%; background: radial-gradient(circle, rgb(37 99 235 / 0.35), transparent 62%); }
  .calc-result :global(*) { position: relative; }
  .calc-result :global(.big) { font-family: var(--font-display); font-size: clamp(48px, 6vw, 72px); font-weight: 700; letter-spacing: -0.035em; line-height: 1; }
  .calc-result :global(.label) { color: #93a3ba; font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; }
  .calc-result :global(dl) { display: grid; grid-template-columns: 1fr auto; gap: 10px 20px; margin: 0; font-size: 15.5px; }
  .calc-result :global(dt) { color: #aab6c8; }
  .calc-result :global(dd) { margin: 0; text-align: right; font-variant-numeric: tabular-nums; }
  .calc-result :global(.cta) { justify-self: start; }
  @media (max-width: 900px) { .calc { grid-template-columns: 1fr; } }
</style>
