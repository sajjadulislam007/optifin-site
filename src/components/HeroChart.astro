---
// Decorative data layer for the dark hero: a revenue line and a net-profit
// line with an area fill, drawn across the background. It is abstract on
// purpose (no axis labels or numbers), so it cannot be read as a claim.
// scripts/motion/heroData.ts draws it in and adds a slight pointer parallax;
// without JavaScript or with reduced motion it simply sits there, drawn.
---
<div class="hero-chart" aria-hidden="true" data-hero-chart>
  <svg viewBox="0 0 1440 560" preserveAspectRatio="xMidYMid slice" fill="none">
    <defs>
      <linearGradient id="hc-area" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2dd4bf" stop-opacity="0.28" />
        <stop offset="1" stop-color="#2563eb" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="hc-line" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#2563eb" stop-opacity="0" />
        <stop offset="0.25" stop-color="#3b82f6" />
        <stop offset="1" stop-color="#2dd4bf" />
      </linearGradient>
    </defs>
    <g class="hc-ticks">
      <path d="M0 140H1440M0 280H1440M0 420H1440" />
    </g>
    <path class="hc-revenue" pathLength="1" d="M-20 400 C 90 380, 170 430, 290 372 S 470 318, 590 340 S 800 252, 930 276 S 1180 190, 1460 128" />
    <path class="hc-area" d="M-20 470 C 90 452, 170 492, 290 446 S 470 400, 590 418 S 800 346, 930 362 S 1180 292, 1460 236 V 560 H -20 Z" fill="url(#hc-area)" />
    <path class="hc-profit-glow" pathLength="1" d="M-20 470 C 90 452, 170 492, 290 446 S 470 400, 590 418 S 800 346, 930 362 S 1180 292, 1460 236" />
    <path class="hc-profit" pathLength="1" d="M-20 470 C 90 452, 170 492, 290 446 S 470 400, 590 418 S 800 346, 930 362 S 1180 292, 1460 236" />
    <g class="hc-end">
      <circle class="hc-halo" cx="1380" cy="246" r="11" />
      <circle cx="1380" cy="246" r="4.5" />
    </g>
  </svg>
</div>

<style>
  .hero-chart { position: absolute; inset: 0; pointer-events: none; overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent), linear-gradient(#000 55%, transparent 96%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent), linear-gradient(#000 55%, transparent 96%);
    mask-composite: intersect;
    opacity: 0.62;
  }
  svg { position: absolute; left: 0; right: 0; top: 70px; width: 100%; height: 560px; will-change: transform; }
  .hc-ticks path { stroke: rgb(255 255 255 / 0.05); stroke-width: 1; stroke-dasharray: 2 8; }
  .hc-revenue { stroke: rgb(255 255 255 / 0.22); stroke-width: 1.5; stroke-linecap: round; }
  .hc-profit { stroke: url(#hc-line); stroke-width: 2.5; stroke-linecap: round; }
  .hc-profit-glow { stroke: url(#hc-line); stroke-width: 9; stroke-linecap: round; opacity: 0.16; }
  .hc-end circle { fill: #2dd4bf; }
  .hc-end .hc-halo { fill: rgb(45 212 191 / 0.22); }
  @media (max-width: 700px) { svg { height: 380px; } .hero-chart { opacity: 0.6; } }
</style>
