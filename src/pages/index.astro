---
import BaseLayout from "../layouts/BaseLayout.astro";
import Screen from "../components/Screen.astro";
import Icon from "../components/Icon.astro";
import { ALSO_INCLUDED, COMING_SOON, FAQ, FEATURES, PLANS, SITE, installUrl } from "../data/site";

const tour = [
  { name: "dashboard-overview", title: "Dashboard", text: "Net profit, margin and orders, with coverage on every number.", href: "/features/profit-dashboard/" },
  { name: "costs-overview", title: "Costs", text: "Product costs, shipping, fees and operating costs, with what is still missing.", href: "/features/costs/" },
  { name: "orders", title: "Orders", text: "Profit for every order, with the full breakdown behind it.", href: "/features/orders-and-products/" },
  { name: "customer-value", title: "Customers", text: "Lifetime value on revenue and on profit, cohorts and retention.", href: "/features/customers/" },
  { name: "action-center", title: "Action Center", text: "Problems turned into a short, prioritised to-do list.", href: "/features/action-center/" },
];
// Example store for the revenue-to-profit scene (illustrative figures that
// add up exactly: 12,455 − 7,643 = 4,812).
const costs = [
  { label: "Product costs", value: 4120 },
  { label: "Advertising", value: 1050 },
  { label: "Shipping", value: 1180 },
  { label: "Operating costs", value: 898 },
  { label: "Payment fees", value: 395 },
];
const revenue = 12455;
const profit = revenue - costs.reduce((s, c) => s + c.value, 0);
const fmt = (n: number) => `$${n.toLocaleString("en-US")}`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Optifin",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Shopify",
    description: SITE.description,
    url: SITE.url,
    offers: PLANS.map((p) => ({ "@type": "Offer", name: p.name, price: p.price.toFixed(2), priceCurrency: "USD" })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<BaseLayout
  title="Optifin: Shopify Profit Analytics You Can Trust"
  description="See your true Shopify profit after product costs, fees, shipping, ads and operating costs, with coverage on every number. Free Starter plan."
  schema={schema}
  headerTone="dark"
>
  <!-- 1. HERO ------------------------------------------------------------ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-bg" aria-hidden="true">
      <div class="glow glow-a"></div>
      <div class="glow glow-b"></div>
      <div class="glow glow-c"></div>
      <div class="grid-lines"></div>
    </div>
    <div class="container hero-copy">
      <p class="eyebrow hero-eyebrow">Profit analytics for Shopify</p>
      <h1 id="hero-title" class="display" data-hero-title>
        Your true Shopify profit,{" "}<span class="gradient-text">with nothing hidden.</span>
      </h1>
      <p class="lead hero-lead" data-hero-fade>
        Optifin adds product costs, fees, shipping, ads and operating costs to your Shopify sales, then shows exactly how complete every number is.
      </p>
      <div class="hero-actions" data-hero-fade>
        <a class="btn btn--primary" href={installUrl("hero")}>Install on Shopify <Icon name="arrow" size={18} /></a>
        <a class="btn btn--ghost" href="#tour">See how it works</a>
      </div>
      <p class="hero-trust" data-hero-fade>
        <span><Icon name="check" size={16} /> Works inside your Shopify admin</span>
        <span><Icon name="check" size={16} /> Free Starter plan</span>
        <span><Icon name="check" size={16} /> Read-only access to your store</span>
      </p>
    </div>
    <div class="container hero-stage" data-hero-stage>
      <div class="stage-inner" data-hero-screen>
        <Screen class="hero-desktop" name="dashboard-overview" alt="Optifin dashboard showing net profit, revenue, margin and coverage notes" eager sizes="(max-width: 1200px) 100vw, 1200px" />
        <Screen class="hero-mobile" name="dashboard-mobile" alt="Optifin dashboard on a phone" bare sizes="(max-width: 640px) 90vw, 1px" />
      </div>
      <div class="float float-profit card" data-float="1.4" aria-hidden="true">
        <span class="float-label">Net profit</span>
        <span class="float-value tabular" data-count="5608.18" data-prefix="$">$5,608.18</span>
        <span class="badge">Based on 93% of product costs</span>
      </div>
      <div class="float float-change card" data-float="0.8" aria-hidden="true">
        <span class="dot"></span>
        <span><strong>Refund value</strong> up 17.7% vs previous period</span>
      </div>
      <div class="float float-trust card" data-float="1.1" aria-hidden="true">
        <Icon name="shield" size={20} />
        <span>Missing costs flagged,<br />never counted as $0</span>
      </div>
    </div>
    <p class="container sample-note hero-note">Shown with sample data.</p>
  </section>

  <!-- 2. REVENUE IS NOT PROFIT ------------------------------------------- -->
  <section class="section section--dark scene" aria-labelledby="scene-title" data-scene>
    <div class="container scene-grid">
      <div class="scene-copy">
        <p class="eyebrow">The problem</p>
        <h2 id="scene-title" class="h2">Shopify shows you sales. Here is what you actually kept.</h2>
        <p class="lead">Every order carries costs Shopify does not subtract: the product, the shipping label, the payment fee, the ads that brought the customer and the cost of running the store.</p>
        <p class="small muted scene-note">Example store, 30 days.</p>
      </div>
      <div class="ledger card" aria-label="Example: revenue minus costs equals net profit">
        <div class="ledger-row ledger-total">
          <span data-ledger-label>Revenue</span>
          <span class="tabular" data-ledger-revenue data-value={revenue}>{fmt(revenue)}</span>
        </div>
        <div class="ledger-bar"><span data-ledger-fill style="--w:100%"></span></div>
        <ul class="ledger-costs">
          {costs.map((c) => (
            <li data-ledger-cost data-value={c.value}>
              <span class="ledger-name">− {c.label}</span>
              <span class="ledger-track"><span style={`--w:${(c.value / revenue) * 100}%`}></span></span>
              <span class="tabular">{fmt(c.value)}</span>
            </li>
          ))}
        </ul>
        <div class="ledger-row ledger-profit" data-ledger-result>
          <span>Net profit</span>
          <span class="tabular"><strong>{fmt(profit)}</strong>{" "}<em>{Math.round((profit / revenue) * 100)}% margin</em></span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. TRUST BENTO -------------------------------------------------------- -->
  <section class="section" aria-labelledby="trust-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Numbers you can trust</p>
        <h2 id="trust-title" class="h2">Every number tells you how complete it is.</h2>
        <p class="lead">Most profit apps show a number. Optifin shows the number and what it is based on, so a missing cost never quietly inflates your profit.</p>
      </div>
      <div class="bento" data-reveal-group>
        <article class="tile tile-hero">
          <div class="tile-copy">
            <h3 class="h3">Coverage on every card</h3>
            <p>A note such as “Based on 93% of product costs” appears the moment a number rests on incomplete inputs, with a link to finish them.</p>
          </div>
          <div class="tile-shot">
            <Screen name="dashboard-kpi-card" alt="Net profit card noting it is based on 93% of product costs" bare sizes="(max-width: 900px) 90vw, 560px" />
          </div>
        </article>
        <article class="tile">
          <Icon name="eye" size={28} />
          <h3 class="h3">Missing is never $0</h3>
          <p>Products without a cost are flagged and listed, not counted as free.</p>
        </article>
        <article class="tile">
          <Icon name="shield" size={28} />
          <h3 class="h3">Honest comparisons</h3>
          <p>When a change would mislead, it is held back and the reason is shown.</p>
        </article>
        <article class="tile tile-wide">
          <Icon name="layers" size={28} />
          <div>
            <h3 class="h3">One calculation everywhere</h3>
            <p>Cards, charts, the Profit and Loss report and every export come from the same engine, so they always agree.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. PRODUCT TOUR -------------------------------------------------------- -->
  <section id="tour" class="tour section--soft" aria-labelledby="tour-title" data-tour>
    <div class="container tour-head">
      <p class="eyebrow">Product tour</p>
      <h2 id="tour-title" class="h2">Everything in one place, inside Shopify.</h2>
      <div class="tour-progress" aria-hidden="true"><span data-tour-progress></span></div>
    </div>
    <div class="tour-viewport">
      <ol class="tour-track" data-tour-track>
        {tour.map((t, i) => (
          <li class="tour-slide">
            <Screen name={t.name} alt={`Optifin ${t.title} screen`} sizes="(max-width: 900px) 92vw, 900px" />
            <div class="tour-caption">
              <span class="tour-index">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="h3">{t.title}</h3>
                <p>{t.text}</p>
                <a class="link-arrow" href={t.href}>Learn more <Icon name="arrow" size={16} /></a>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <p class="container sample-note">Shown with sample data.</p>
  </section>

  <!-- 5. KNOW WHAT CHANGED -------------------------------------------------- -->
  <section class="section" aria-labelledby="changed-title">
    <div class="container changed">
      <div class="changed-copy" data-reveal>
        <p class="eyebrow">Executive briefing</p>
        <h2 id="changed-title" class="h2">Know what changed, and what to do about it.</h2>
        <p class="lead">The briefing compares the period with the one before, picks the changes that matter and puts the actions beside them.</p>
        <ul class="ticks">
          <li><Icon name="check" size={18} /> Plain-language changes, not a wall of charts</li>
          <li><Icon name="check" size={18} /> Actions that need a decision, ranked by urgency</li>
          <li><Icon name="check" size={18} /> One click to the breakdown or the fix</li>
        </ul>
      </div>
      <div class="changed-shot" data-callouts>
        <Screen name="dashboard-briefing" alt="Executive briefing showing what changed and what needs attention" note />
        <svg class="callout-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path d="M18 48 C 10 70, 6 82, 4 96" />
          <path d="M66 46 C 74 70, 86 82, 96 96" />
        </svg>
        <span class="callout callout-a" aria-hidden="true">Biggest change, explained</span>
        <span class="callout callout-b" aria-hidden="true">The fix, one click away</span>
      </div>
    </div>
  </section>

  <!-- 6. FEATURE GRID -------------------------------------------------------- -->
  <section class="section section--soft" aria-labelledby="features-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Everything included</p>
        <h2 id="features-title" class="h2">Built for the questions you actually ask.</h2>
      </div>
      <div class="feature-grid" data-count={FEATURES.length} data-reveal-group>
        {FEATURES.map((f) => (
          <a class="feature card" href={`/features/${f.slug}/`}>
            <span class="feature-eyebrow">{f.eyebrow}</span>
            <h3 class="h3">{f.name}</h3>
            <p>{f.summary}</p>
            <span class="link-arrow">Explore <Icon name="arrow" size={16} /></span>
          </a>
        ))}
        <div class="feature card feature-list">
          <span class="feature-eyebrow">Also included</span>
          <ul>{ALSO_INCLUDED.map((x) => <li><Icon name="check" size={16} /> {x}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. COMING SOON --------------------------------------------------------- -->
  <section class="section section--dark soon" aria-labelledby="soon-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Coming soon</p>
        <h2 id="soon-title" class="h2">We ship what we can prove is right. These are next.</h2>
      </div>
      <ul class="soon-rail" data-reveal-group>
        {COMING_SOON.slice(0, 6).map((c) => (
          <li class="soon-card">
            <span class="badge badge--soon">Coming soon</span>
            <Icon name={c.icon} size={26} />
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </li>
        ))}
      </ul>
      <a class="link-arrow soon-more" href="/coming-soon/">See the full roadmap <Icon name="arrow" size={16} /></a>
    </div>
  </section>

  <!-- 8. PRICING ------------------------------------------------------------- -->
  <section class="section" aria-labelledby="pricing-title">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Pricing</p>
        <h2 id="pricing-title" class="h2">Start free. Pay as your store grows.</h2>
        <p class="lead">Billed through Shopify. Change plans or cancel any time.</p>
      </div>
      <div class="plans" data-reveal-group>
        {PLANS.map((p) => (
          <article class:list={["plan card", { featured: p.featured }]}>
            {p.featured && <span class="badge badge--soon plan-flag">Most popular</span>}
            <h3 class="h3">{p.name}</h3>
            <p class="plan-price"><span class="tabular">{p.priceLabel}</span>{p.price > 0 && <small>/month base</small>}</p>
            <p class="plan-note">{p.note}</p>
            <ul>{p.highlights.slice(0, 3).map((h) => <li><Icon name="check" size={16} /> {h}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="center-link"><a class="link-arrow" href="/pricing/">Compare plans in detail <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <!-- 9. FAQ ----------------------------------------------------------------- -->
  <section class="section section--soft" aria-labelledby="faq-title">
    <div class="container faq-wrap">
      <div data-reveal>
        <p class="eyebrow">Questions</p>
        <h2 id="faq-title" class="h2">Good to know.</h2>
        <p class="lead">Something else? Read the <a href="/docs/">docs</a> or email <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>.</p>
      </div>
      <div class="faq" data-reveal-group>
        {FAQ.map((f) => (
          <details>
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initHome } from "../scripts/motion/home";
  import { initHeroTitle } from "../scripts/motion/heroTitle";
  import { initHeroGradients } from "../scripts/motion/heroGradients";
  initHome();
  // Hero headline letters: entrance wave + cursor ripple (skipped under
  // reduced motion; the headline then stays plain text).
  if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    initHeroTitle();
    initHeroGradients();
  }
</script>

<style>
  /* HERO */
  .hero { position: relative; background: var(--navy-900); color: #fff; padding-top: 150px; margin-top: -76px; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; pointer-events: none; }
  .glow { position: absolute; border-radius: 50%; filter: blur(20px); }
  .glow-a { width: 900px; height: 900px; left: 50%; top: 260px; transform: translateX(-50%); background: radial-gradient(circle, rgb(37 99 235 / 0.55), transparent 62%); }
  .glow-b { width: 600px; height: 600px; right: -160px; top: -200px; background: radial-gradient(circle, rgb(45 212 191 / 0.18), transparent 65%); }
  .glow-c { width: 520px; height: 520px; left: -180px; top: 120px; background: radial-gradient(circle, rgb(45 212 191 / 0.14), transparent 65%); opacity: 0.6; }
  .glow { will-change: transform; }
  .grid-lines {
    position: absolute; inset: 0; opacity: 0.35;
    background-image: linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 50% 20%, #000 20%, transparent 70%);
  }
  .hero-copy { position: relative; text-align: center; display: grid; justify-items: center; gap: 26px; }
  .hero-eyebrow { color: var(--brand-400); }
  .hero h1 { max-width: 15ch; }
  .hero-lead { max-width: 60ch; color: #b8c4d6; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .hero-actions .btn--ghost { color: #fff; }
  .hero-trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 24px; font-size: 14.5px; color: #93a3ba; }
  .hero-trust span { display: inline-flex; align-items: center; gap: 6px; }
  .hero-trust :global(svg) { color: var(--brand-400); }
  .hero-stage { position: relative; margin-top: 72px; perspective: 1400px; }
  .stage-inner { transform-origin: 50% 0%; box-shadow: var(--shadow-glow); border-radius: var(--radius-lg); }
  .stage-inner :global(.screen) { max-height: 860px; }
  .stage-inner :global(.screen img) { object-fit: cover; object-position: top; max-height: 826px; }
  .stage-inner :global(.screen) { -webkit-mask-image: linear-gradient(#000 78%, transparent); mask-image: linear-gradient(#000 78%, transparent); }
  .stage-inner :global(.hero-mobile) { display: none; }
  @media (max-width: 640px) {
    .stage-inner :global(.hero-desktop) { display: none; }
    .stage-inner :global(.hero-mobile) { display: block; width: min(330px, 86vw); margin-inline: auto; }
    .stage-inner :global(.hero-mobile .screen) { border-radius: 30px; border: 8px solid #1b2a44; max-height: 620px; }
    .stage-inner :global(.hero-mobile .screen img) { object-fit: cover; object-position: top; max-height: 604px; }
    .stage-inner { box-shadow: none; }
  }
  .hero-note { position: relative; color: #6f7f96; padding-bottom: 72px; padding-top: 14px; text-align: center; }
  .float { position: absolute; display: flex; align-items: center; gap: 10px; padding: 14px 18px; border-radius: 18px; box-shadow: var(--shadow-lg); border: 1px solid rgb(7 21 41 / 0.06); font-size: 14.5px; color: var(--ink); }
  .float-profit { left: -36px; top: 58%; flex-direction: column; align-items: flex-start; gap: 6px; padding: 18px 22px; }
  .float-label { font-size: 13px; color: var(--ink-muted); font-weight: 500; }
  .float-value { font-family: var(--font-display); font-weight: 700; font-size: 32px; letter-spacing: -0.03em; line-height: 1; }
  .float-change { right: -24px; top: 18%; max-width: 260px; }
  .float-change .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--brand-500); flex: none; box-shadow: 0 0 0 5px rgb(59 130 246 / 0.15); }
  .float-trust { right: 6%; bottom: -26px; }
  .float-trust :global(svg) { color: var(--profit); flex: none; }
  @media (max-width: 900px) {
    .float-change, .float-trust { display: none; }
    .float-profit { left: 8px; top: auto; bottom: -24px; padding: 12px 16px; }
    .float-value { font-size: 24px; }
    .hero { padding-top: 130px; }
    .hero-stage { margin-top: 48px; }
  }

  /* SCENE */
  .scene-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .scene-copy { display: grid; gap: 22px; }
  .scene-note { color: #8392a8; }
  .ledger { background: #0d1f3a; border-color: rgb(255 255 255 / 0.08); padding: clamp(22px, 3vw, 36px); color: #e8edf5; box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.6); }
  .ledger-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-family: var(--font-display); }
  .ledger-total span:first-child { font-size: 15px; color: #93a3ba; letter-spacing: 0.04em; text-transform: uppercase; }
  .ledger-total span:last-child { font-size: clamp(34px, 4vw, 48px); font-weight: 700; letter-spacing: -0.03em; }
  .ledger-bar { height: 12px; border-radius: 99px; background: rgb(255 255 255 / 0.06); margin: 16px 0 26px; overflow: hidden; }
  .ledger-bar span { display: block; height: 100%; width: var(--w); background: var(--brand-gradient); border-radius: inherit; transform-origin: left; }
  .ledger-costs { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .ledger-costs li { display: grid; grid-template-columns: 9.5rem 1fr 5.5rem; align-items: center; gap: 14px; font-size: 15px; color: #b8c4d6; }
  .ledger-costs li span:last-child { text-align: right; color: #e8edf5; }
  .ledger-track { height: 8px; border-radius: 99px; background: rgb(255 255 255 / 0.05); overflow: hidden; }
  .ledger-track span { display: block; height: 100%; width: var(--w); background: #5a6b85; border-radius: inherit; transform-origin: left; }
  .ledger-profit { margin-top: 26px; padding-top: 22px; border-top: 1px dashed rgb(255 255 255 / 0.15); }
  .ledger-profit span:first-child { font-size: 18px; font-weight: 600; }
  .ledger-profit strong { font-size: clamp(30px, 3.4vw, 40px); color: #3ddc97; letter-spacing: -0.03em; }
  .ledger-profit em { font-style: normal; font-size: 15px; color: #93a3ba; margin-left: 6px; }
  @media (max-width: 900px) {
    .scene-grid { grid-template-columns: 1fr; }
    .ledger-costs li { grid-template-columns: 7.5rem 1fr 4.5rem; font-size: 14px; }
  }

  /* SECTION HEAD */
  .section-head { display: grid; gap: 18px; max-width: 760px; margin-bottom: clamp(40px, 6vw, 72px); }
  .section-head.center { margin-inline: auto; text-align: center; justify-items: center; }

  /* BENTO */
  .bento { display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: minmax(220px, auto); gap: 20px; }
  .tile { background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 30px; display: grid; align-content: start; gap: 14px; }
  .tile :global(svg) { color: var(--brand-600); }
  .tile p { color: var(--ink-soft); }
  .tile-hero { grid-column: span 2; grid-row: span 2; background: linear-gradient(160deg, #eef6ff, #fff 55%); display: grid; grid-template-rows: auto 1fr; overflow: hidden; }
  .tile-copy { display: grid; gap: 10px; max-width: 46ch; }
  .tile-shot { align-self: end; justify-self: center; width: min(100%, 470px); margin: 24px 0 -30px; transform: rotate(-2deg); }
  .tile-shot :global(.screen) { box-shadow: var(--shadow-lg); border-radius: 18px; }
  .tile-wide { grid-column: 1 / -1; grid-template-columns: auto 1fr; align-items: center; gap: 20px; min-height: 0; }
  @media (max-width: 900px) {
    .bento { grid-template-columns: 1fr; }
    .tile-hero, .tile-wide { grid-column: auto; grid-row: auto; }
    .tile-shot { margin-bottom: -20px; }
  }

  /* TOUR */
  .tour { padding-block: var(--section) calc(var(--section) * 0.6); overflow: hidden; }
  .tour-head { display: grid; gap: 18px; margin-bottom: 48px; }
  .tour-progress { height: 3px; background: var(--line); border-radius: 3px; overflow: hidden; max-width: 320px; }
  .tour-progress span { display: block; height: 100%; width: 100%; background: var(--brand-gradient); transform: scaleX(0); transform-origin: left; }
  .tour-viewport { overflow: hidden; }
  .tour-track { list-style: none; margin: 0; padding: 0 max(var(--gutter), calc((100vw - var(--container)) / 2)); display: flex; gap: 40px; width: max-content; }
