---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
const guides = (await getCollection("guides")).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
---
<BaseLayout
  title="Shopify Profit Guides | Optifin"
  description="Practical guides on Shopify profit: true profit, COGS, contribution margin, break-even ROAS, POAS and reading your numbers with confidence."
  breadcrumbs={[{ name: "Guides", href: "/guides/" }]}
  headerTone="dark"
>
  <PageHero eyebrow="Guides" title="Understand your Shopify profit." lead="Clear, practical guides on the numbers that decide whether your store makes money." />
  <section class="section">
    <div class="container">
      <div class="grid" data-reveal-group>
        {guides.map((g, i) => (
          <a class:list={["guide card", { lead: i === 0 }]} href={`/guides/${g.id}/`}>
            <span class="badge">{g.data.tag}</span>
            <h2 class="h3">{g.data.title}</h2>
            <p>{g.data.description}</p>
            <span class="meta">{g.data.readingMinutes} min read <Icon name="arrow" size={16} /></span>
          </a>
        ))}
        <a data-spotlight class="guide card tool" href="/tools/profit-margin-calculator/">
          <span class="badge badge--soon">Free tool</span>
          <h2 class="h3">Profit margin calculator</h2>
          <p>Work out profit and margin for one order in seconds.</p>
          <span class="meta">Open the calculator <Icon name="arrow" size={16} /></span>
        </a>
        <a data-spotlight class="guide card tool" href="/tools/break-even-roas-calculator/">
          <span class="badge badge--soon">Free tool</span>
          <h2 class="h3">Break-even ROAS calculator</h2>
          <p>Find the ROAS at which your ads stop losing money.</p>
          <span class="meta">Open the calculator <Icon name="arrow" size={16} /></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .guide { padding: 28px; display: grid; gap: 12px; align-content: start; text-decoration: none; transition: transform 0.3s, box-shadow 0.3s; }
  .guide:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .guide .badge { justify-self: start; }
  .guide p { color: var(--ink-soft); }
  .guide.lead { grid-column: span 2; background: var(--navy-900); color: #fff; border-color: transparent; }
  .guide.lead p { color: #aab6c8; }
  .guide.lead .h3 { font-size: clamp(26px, 3vw, 36px); }
  .meta { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--brand-700); font-size: 15px; }
  .guide.lead .meta { color: var(--brand-400); }
  .tool { background: linear-gradient(160deg, #eef6ff, #fff 60%); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } .guide.lead { grid-column: auto; } }
</style>
