---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CalcLayout from "../../components/CalcLayout.astro";
import { installUrl } from "../../data/site";
const schema = [{
  "@context": "https://schema.org", "@type": "WebApplication", name: "Shopify Profit Margin Calculator",
  applicationCategory: "BusinessApplication", operatingSystem: "Any", offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
}];
---
<BaseLayout
  title="Shopify Profit Margin Calculator (Free) | Optifin"
  description="Free Shopify profit margin calculator: enter price, product cost, shipping, payment fees and ad cost per order to see profit per order and margin."
  breadcrumbs={[{ name: "Free tools", href: "/tools/" }, { name: "Profit margin calculator", href: "/tools/profit-margin-calculator/" }]}
  schema={schema}
  headerTone="dark"
>
  <PageHero eyebrow="Free tool" title="Shopify profit margin calculator" lead="See what one order really earns after product cost, shipping, payment fees and advertising." />
  <CalcLayout title="Profit margin calculator">
    <Fragment slot="inputs">
      <label>Selling price <span class="hint">What the customer pays for the product (excluding tax).</span><div class="field"><span>$</span><input type="number" inputmode="decimal" min="0" step="0.01" id="price" value="60" /></div></label>
      <label>Product cost (COGS)<div class="field"><span>$</span><input type="number" inputmode="decimal" min="0" step="0.01" id="cogs" value="22" /></div></label>
      <label>Shipping cost you pay<div class="field"><span>$</span><input type="number" inputmode="decimal" min="0" step="0.01" id="ship" value="6" /></div></label>
      <label>Payment fee <span class="hint">Percentage plus fixed fee per order, for example 2.9% + $0.30.</span>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div class="field"><input class="pct" type="number" inputmode="decimal" min="0" step="0.1" id="feePct" value="2.9" /><span class="suffix">%</span></div>
          <div class="field"><span>$</span><input type="number" inputmode="decimal" min="0" step="0.01" id="feeFixed" value="0.30" /></div>
        </div>
      </label>
      <label>Ad cost per order<div class="field"><span>$</span><input type="number" inputmode="decimal" min="0" step="0.01" id="ads" value="12" /></div></label>
    </Fragment>
    <Fragment slot="result">
      <p class="label">Profit per order</p>
      <p class="big" id="profitOut">$0.00</p>
      <dl>
        <dt>Margin</dt><dd id="marginOut">0%</dd>
        <dt>Contribution margin (before ads)</dt><dd id="cmOut">0%</dd>
        <dt>Total costs per order</dt><dd id="costOut">$0.00</dd>
        <dt>Break-even ROAS</dt><dd id="beOut">—</dd>
      </dl>
      <a class="btn btn--primary cta" href={installUrl("tool-margin")}>Track every order in Optifin</a>
    </Fragment>

    <h2>How the calculation works</h2>
    <p>Profit per order = price − product cost − shipping − payment fee − ad cost per order. Margin = profit ÷ price.</p>
    <p>Contribution margin leaves out advertising: it shows what each order contributes before you pay for the customer. Break-even ROAS is 1 ÷ contribution margin: the return on ad spend at which ads stop losing money.</p>
    <h2>Why one order is not the whole story</h2>
    <p>Real stores have refunds, discounts, changing supplier costs and operating costs such as apps and salaries. <a href="/features/profit-dashboard/">Optifin</a> applies all of them to every order automatically, and shows when a cost is missing instead of counting it as $0.</p>
    <p>Read more: <a href="/guides/how-to-calculate-true-profit-on-shopify/">How to calculate true profit on Shopify</a>.</p>
  </CalcLayout>
</BaseLayout>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const money = (n: number) => (n < 0 ? "−$" : "$") + Math.abs(n).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const pct = (n: number) => `${(n * 100).toFixed(1)}%`;
  function calc() {
    const v = (id: string) => Math.max(0, Number($(id).value) || 0);
    const price = v("price");
    const fee = price * (v("feePct") / 100) + v("feeFixed");
    const beforeAds = price - v("cogs") - v("ship") - fee;
    const profit = beforeAds - v("ads");
    const cm = price ? beforeAds / price : 0;
    $("profitOut").textContent = money(profit);
    ($("profitOut") as HTMLElement).style.color = profit >= 0 ? "#3ddc97" : "#ff8a80";
    $("marginOut").textContent = price ? pct(profit / price) : "—";
    $("cmOut").textContent = price ? pct(cm) : "—";
    $("costOut").textContent = money(price - profit);
    $("beOut").textContent = cm > 0 ? `${(1 / cm).toFixed(2)}×` : "Not reachable";
  }
  document.querySelectorAll("input").forEach((i) => i.addEventListener("input", calc));
  calc();
</script>
