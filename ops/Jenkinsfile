// optifin-site: pick a BRANCH and an ENVIRONMENT.
//   development  build the branch and show it at https://dev.optifin.app
//   build-only   check that the site builds, deploy nothing
//   live         main only: build, you confirm, deploy to https://optifin.app
//
// Always read from main, never from the branch you pick, so a feature branch
// cannot change what runs with deploy rights. Jenkins never touches Docker: each
// step is one SSH call to the server's restricted command, which hands "site ..."
// to ops/ci-run.sh of this repository (it builds the site inside Docker).
pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '30'))
    disableConcurrentBuilds()
  }

  environment {
    CI_HOST = 'deploy@host.docker.internal'
    SSH = 'ssh -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30'
  }

  stages {
    stage('Check request') {
      steps {
        script {
          if (params.ENVIRONMENT == 'live' && params.BRANCH != 'origin/main') {
            error('Live only builds main. Choose origin/main, or pick development.')
          }
        }
      }
    }

    stage('Checkout branch') {
      steps {
        checkout([$class: 'GitSCM',
          branches: [[name: params.BRANCH]],
          userRemoteConfigs: [[url: 'https://github.com/sajjadulislam007/optifin-site.git']]])
        script {
          env.SHA = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
          env.TARGET = params.ENVIRONMENT == 'build-only' ? 'build' : params.ENVIRONMENT
          currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.ENVIRONMENT} ${params.BRANCH.replace('origin/', '')} ${env.SHA.take(8)}"
        }
      }
    }

    stage('Build') {
      steps {
        sshagent(credentials: ['host-ci']) {
          sh '$SSH $CI_HOST "site build $SHA"'
        }
      }
    }

    stage('Confirm live') {
      when { expression { params.ENVIRONMENT == 'live' } }
      steps {
        timeout(time: 30, unit: 'MINUTES') {
          input message: "Publish ${env.SHA.take(8)} to the live website (optifin.app)? Check it on dev.optifin.app first.", ok: 'Publish live'
        }
      }
    }

    stage('Deploy') {
      when { expression { params.ENVIRONMENT != 'build-only' } }
      steps {
        sshagent(credentials: ['host-ci']) {
          sh '$SSH $CI_HOST "site $TARGET $SHA"'
        }
      }
    }
  }

  post {
    success { echo "Done: ${params.ENVIRONMENT} / ${env.SHA.take(8)} from ${params.BRANCH}." }
    failure { echo 'Failed: see the stage logs above. Nothing was deployed after the failing stage.' }
  }
}
