---
// Brand mark: the Optifin SVG logo (ring + rising bars, teal → blue, Audiowide
// wordmark converted to paths). Inlined so "OPTI" takes the current text
// colour: navy on light backgrounds, white on dark ones.
import logoSvg from "../assets/brand/logo.svg?raw";
interface Props { tone?: "light" | "dark"; size?: number }
const { tone = "light", size = 34 } = Astro.props;
// Each instance needs its own gradient ids: a url(#id) that resolves to a
// copy inside a hidden (display:none) logo does not paint.
const uid = `ofg-${Math.random().toString(36).slice(2, 8)}`;
const svg = logoSvg.replaceAll("ofg-audiowide", uid);
---
<span class="logo" data-tone={tone} style={`--h:${size}px`} set:html={svg} />

<style>
  .logo { display: inline-flex; align-items: center; color: var(--navy-900); line-height: 0; }
  .logo[data-tone="dark"] { color: #fff; }
  .logo :global(svg) { height: var(--h); width: auto; display: block; }
</style>
